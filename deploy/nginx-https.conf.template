# These zones belong in the http context, alongside (not inside) server blocks.
# Per-IP limits use the socket peer. Configure trusted real-IP ranges separately
# if Cloudflare is enabled; never trust arbitrary X-Forwarded-For headers.
limit_req_zone $binary_remote_addr zone=pump_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=pump_export:10m rate=2r/m;
limit_conn_zone $binary_remote_addr zone=pump_connections:10m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.__DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    resolver 127.0.0.11 valid=30s ipv6=off;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn pump_connections 20;
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;

    location ~ ^/api/public/(history|research)\.csv$ {
        limit_except GET { deny all; }
        limit_req zone=pump_export burst=2 nodelay;
        set $pump_upstream pump-paper:8765;
        proxy_pass http://$pump_upstream;
        proxy_set_header Host 127.0.0.1:8765;
    }

    location ~ "^/api/public/(summary|catalog|research|live-feed|community|health|strategies/[a-z0-9-]{1,40}(/trades)?)$" {
        limit_except GET { deny all; }
        limit_req zone=pump_api burst=30 nodelay;
        set $pump_upstream pump-paper:8765;
        proxy_pass http://$pump_upstream;
        proxy_set_header Host 127.0.0.1:8765;
    }

    # Positive allowlist: unknown APIs, operator pages and data paths never proxy.
    location ~ "^/($|engine(/[a-z0-9-]{1,40})?$|strategies(/[a-z0-9-]{1,40})?$|research$|affiliate$|contact$|legal$|[a-z-]+\.(js|css)$)" {
        limit_except GET { deny all; }
        limit_req zone=pump_api burst=30 nodelay;
        set $pump_upstream pump-paper:8765;
        proxy_pass http://$pump_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8765;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / { return 404; }
}

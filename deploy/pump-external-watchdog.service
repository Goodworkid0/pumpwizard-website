[Unit]
Description=PumpWizard public uptime check from independent host
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/c/Desktop/projekti/pump-agent
ExecStart=/home/c/Desktop/projekti/pump-agent/.venv-backup/bin/python scripts/external_watchdog.py --notify
TimeoutStartSec=45
UMask=0077
NoNewPrivileges=yes
